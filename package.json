{
  "name": "base-token-creator",
  "version": "7.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "compile": "hardhat compile",
    "sync:artifact": "node scripts/export-artifact.mjs",
    "contracts:build": "npm run compile && npm run sync:artifact",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:contract": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration",
    "deploy:factory": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy-factory.ts --network baseSepolia",
    "deploy:factory:local": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy-factory.ts --network localhost"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.0",
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0",
    "@x402/svm": "^2.3.0",
    "next": "14.2.35",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.37.0",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2",
    "vitest": "^2.1.8"
  }
}
