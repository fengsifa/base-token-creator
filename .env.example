# ---------------------------------------------------------------------------
# Tokenbase (base-token-creator) — environment template
#
# Copy to .env.local for local development, and use the same file for the
# server deployment. .env.local is git-ignored: never commit real values.
#
# Values prefixed NEXT_PUBLIC_ are read on the *server* at request time and
# handed to the browser, so changing them only needs a container restart —
# no image rebuild.
# ---------------------------------------------------------------------------

# --- Active network --------------------------------------------------------
# sepolia (default) or mainnet
NEXT_PUBLIC_BASE_NETWORK=sepolia

# --- RPC endpoints ---------------------------------------------------------
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Legacy alias still supported (used for whichever network is active):
# NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# --- Token Factory ---------------------------------------------------------
# REQUIRED before any token can be created. Deploy it once from /setup in the
# browser (no private key needed) or with `npm run deploy:factory`, then paste
# the address here. Left empty, the app says so plainly instead of failing late.
NEXT_PUBLIC_TOKEN_CONTRACT_FACTORY_SEPOLIA=
NEXT_PUBLIC_TOKEN_CONTRACT_FACTORY_MAINNET=

# --- Service fee -----------------------------------------------------------
# "0" (or empty) = free mode. The user signs ONE transaction and pays only gas.
# A non-zero fee switches to the two-transaction flow (fee, then deploy) and
# REQUIRES a recipient address, otherwise creation is blocked by design.
# Any non-zero value below 0.0001 is automatically raised to 0.0001, because a
# dust fee costs the user an extra transaction for nothing.
NEXT_PUBLIC_TOKEN_CREATOR_FEE_SEPOLIA=0
NEXT_PUBLIC_TOKEN_CREATOR_FEE_MAINNET=
NEXT_PUBLIC_TOKEN_CREATOR_FEE_RECIPIENT_SEPOLIA=
NEXT_PUBLIC_TOKEN_CREATOR_FEE_RECIPIENT_MAINNET=

# --- WalletConnect (optional) ---------------------------------------------
# Empty means only browser-injected wallets such as MetaMask are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Server only -----------------------------------------------------------
# Used by the admin page and the creation-record mirror. The chain stays
# authoritative if the database is unavailable.
DATABASE_URL=postgresql://token_creator:change-me@postgres:5432/token_creator
ADMIN_SECRET=
POSTGRES_PASSWORD=change-me

# --- CLI deployment only (optional) ---------------------------------------
# Only needed for `npm run deploy:factory`. The browser flow at /setup needs no
# key at all. NEVER commit a real private key.
# DEPLOYER_PRIVATE_KEY=0x...
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
